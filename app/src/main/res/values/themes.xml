<resources>
    <!-- Only covers the window behind Compose; the real theme is ui/theme/Theme.kt. -->
    <style name="Theme.Puzzles" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
    </style>

    <!--
        While the app starts: its icon on the icon's own colour, the same in the light and the dark theme,
        instead of an empty window. Then the window turns into Theme.Puzzles.
    -->
    <style name="Theme.Puzzles.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Puzzles</item>
    </style>
</resources>
